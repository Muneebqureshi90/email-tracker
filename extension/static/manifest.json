{
  "manifest_version": 3,
  "name": "MailPulse",
  "version": "0.0.0",
  "description": "Private open tracking for your own Gmail. Talks only to your MailPulse backend on this PC.",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms", "notifications", "scripting", "declarativeNetRequest"],
  "host_permissions": ["https://mail.google.com/*", "http://127.0.0.1/*", "http://localhost/*", "https://*.ts.net/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://mail.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end" }],
  "action": {
    "default_title": "MailPulse",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "options.html"
}
