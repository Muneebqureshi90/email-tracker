# Example only. Create the real file with .\scripts\new-env.ps1 - it generates the secrets.
# Never commit infra\.env. Back up MAILPULSE_ENCRYPTION_KEY outside this PC (docs\SETUP.md section 4).

MAILPULSE_DB_PASSWORD=
MAILPULSE_ENCRYPTION_KEY=
MAILPULSE_JWT_SECRET=
MAILPULSE_SELF_SECRET=

# Your Tailscale Funnel address, for example https://mypc.tail1234.ts.net (no trailing slash).
# Every sent email contains it: never change it after you start tracking.
MAILPULSE_PUBLIC_BASE_URL=

# Origin of the MailPulse extension. Its ID is fixed by the public key in extension/static/manifest.json.
MAILPULSE_EXTENSION_ORIGINS=chrome-extension://pdinoocioohoejhjbeepjdadkkjldgeo

# Free InboxSDK App ID (https://register.inboxsdk.com/). Read by the extension build only.
MAILPULSE_INBOXSDK_APP_ID=

# Host ports (defaults 8080 and 8081). Both are bound to 127.0.0.1 only.
# MAILPULSE_PRIVATE_HOST_PORT=8080
# MAILPULSE_PUBLIC_HOST_PORT=8081
